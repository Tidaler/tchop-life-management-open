# /etc/tidalex/cloud.env - configuration du serveur en ligne TidalEx Resto (root, groupe tidalex, droits 640).
# Écrit par installer-serveur.sh. Ne jamais copier ce fichier rempli ailleurs : il contient des secrets.

NODE_ENV=production
API_MODE=cloud
API_HOST=127.0.0.1
API_PORT=3000

# Base de pilotage (registre des établissements, liens avec les relais locaux).
# Le rôle tidalex a le droit CREATEDB : chaque établissement reçoit sa propre base « etab_<code> ».
DATABASE_URL=postgresql://tidalex:MOT_DE_PASSE_BASE@127.0.0.1:5432/tidalex_pilotage

# Secret de signature des sessions : openssl rand -hex 48
JWT_SECRET=

COOKIE_SECURE=true
WEB_ORIGIN=
TRUST_PROXY=loopback
MEDIA_DIR=/var/lib/tidalex/media

# Adresse publique du serveur en ligne (nom de domaine de TidalEx).
PUBLIC_MENU_URL=https://DOMAINE
