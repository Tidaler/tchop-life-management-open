// /etc/polkit-1/rules.d/50-tchop-caisse.rules - serveur local TCHOP LIFE.
// La session « caisse » ne peut ni éteindre, ni redémarrer, ni mettre en veille le serveur :
// toutes les tablettes en dépendent. L'administrateur garde ces actions (sudo poweroff, sudo reboot).
polkit.addRule(function (action, subject) {
  if (subject.user !== 'caisse') return polkit.Result.NOT_HANDLED;
  if (/^org\.freedesktop\.login1\.(power-off|reboot|halt|suspend|hibernate)/.test(action.id)) {
    return polkit.Result.NO;
  }
  return polkit.Result.NOT_HANDLED;
});
