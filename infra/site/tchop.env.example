# /etc/tchop/tchop.env - configuration du serveur local (propriétaire root, groupe tchop, droits 640).
# Ne jamais copier ce fichier rempli ailleurs que sur le serveur : il contient des secrets.

NODE_ENV=production
API_MODE=site
API_HOST=127.0.0.1
API_PORT=3000

# Base PostgreSQL locale (mot de passe généré à l'installation).
DATABASE_URL=postgresql://tchop:MOT_DE_PASSE_BASE@127.0.0.1:5432/tchop

# Identifiant affiché par « site:setup ».
SITE_ID=

# Secret de signature des sessions : openssl rand -hex 48
JWT_SECRET=

COOKIE_SECURE=true
WEB_ORIGIN=
TRUST_PROXY=loopback
MEDIA_DIR=/var/lib/tchop/media

# Adresse du menu client encodée dans les QR codes. Sur le réseau local seul, les téléphones des
# clients ne font pas confiance au certificat local : n'imprimer les QR codes qu'avec le relais cloud.
PUBLIC_MENU_URL=https://SERVER_IP:8443

BUSINESS_DAY_CUTOFF_HOUR=6

# Relais par le cloud (plus tard, quand le cloud sera en ligne) :
# CLOUD_URL=https://cloud.exemple.cm
# SITE_LINK_SECRET=
