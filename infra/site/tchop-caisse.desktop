# ~/.config/autostart/tchop-caisse.desktop - ouvre l'application de caisse en plein écran à l'ouverture de la session.
# Adresse interne au serveur : la caisse fonctionne même si le réseau local est en panne.
[Desktop Entry]
Type=Application
Name=TCHOP LIFE - Caisse
Exec=google-chrome --app=https://localhost --start-fullscreen --no-first-run
X-GNOME-Autostart-enabled=true
