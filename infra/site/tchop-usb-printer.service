# /etc/systemd/system/tchop-usb-printer.service - imprimante branchée en USB sur le serveur, rendue
# joignable par l'application comme une imprimante réseau : adresse 127.0.0.1, port 9100.
[Unit]
Description=TidalEx Resto - imprimante USB sur 127.0.0.1:9100
After=network.target

[Service]
User=nobody
Group=lp
ExecStart=/usr/bin/socat TCP-LISTEN:9100,bind=127.0.0.1,reuseaddr,fork OPEN:/dev/usb/lp0,wronly
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
