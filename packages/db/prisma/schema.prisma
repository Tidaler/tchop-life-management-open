// Schéma de la Phase 0 : plateforme, identité, salle, catalogue, audit.
// Conventions : docs/architecture/02-modele-donnees.md
// - identifiants UUID v7 ; tenant_id / site_id sur les données métier ;
// - montants en FCFA entiers ; textes traduits en jsonb {"fr": ..., "en": ...}.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Plateforme

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id            String       @id @default(uuid(7)) @db.Uuid
  slug          String       @unique
  name          String
  country       String       @default("CM")
  currency      String       @default("XAF")
  defaultLocale String       @default("fr") @map("default_locale")
  status        TenantStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sites Site[]
  users User[]
  roles Role[]

  @@map("tenant")
}

model Site {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  slug        String
  name        String
  address     String?
  timezone    String    @default("Africa/Douala")
  localDomain String?   @map("local_domain")
  /// Seuils et règles du site (remises, verrouillage automatique, annulations…).
  settings    Json      @default("{}")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(1)

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  userRoles         UserSiteRole[]
  devices           Device[]
  enrollmentCodes   DeviceEnrollmentCode[]
  zones             Zone[]
  tables            DiningTable[]
  qrCodes           QrCode[]
  categories        Category[]
  products          Product[]
  modifierGroups    ModifierGroup[]
  orders            Order[]
  tickets           KitchenTicket[]
  printers          Printer[]
  cashRegisters     CashRegister[]
  customers         Customer[]
  stockLocations    StockLocation[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  inventoryCounts   InventoryCount[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  refunds           Refund[]

  @@unique([tenantId, slug])
  @@map("site")
}

enum DeviceKind {
  tablet
  phone
  desktop
}

model Device {
  id          String     @id @default(uuid(7)) @db.Uuid
  siteId      String     @map("site_id") @db.Uuid
  name        String
  kind        DeviceKind
  /// SHA-256 du jeton d'appareil ; le jeton lui-même n'est jamais stocké.
  tokenHash   String     @unique @map("token_hash")
  lastSeenAt  DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  site     Site          @relation(fields: [siteId], references: [id])
  sessions AuthSession[]

  @@index([siteId])
  @@map("device")
}

model DeviceEnrollmentCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  deviceId    String?   @map("device_id") @db.Uuid
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  site Site @relation(fields: [siteId], references: [id])

  @@map("device_enrollment_code")
}

// ---------------------------------------------------------------- Identité et accès

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  displayName    String    @map("display_name")
  /// Identifiant de connexion, unique pour un client.
  username       String
  phone          String?
  email          String?
  passwordHash   String?   @map("password_hash")
  pinHash        String?   @map("pin_hash")
  locale         String    @default("fr")
  active         Boolean   @default(true)
  pinFailedCount Int       @default(0) @map("pin_failed_count")
  pinLockedUntil DateTime? @map("pin_locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int       @default(1)

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  siteRoles UserSiteRole[]
  sessions  AuthSession[]

  @@unique([tenantId, username])
  @@map("user")
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Code d'un rôle prédéfini (owner, manager…) ou d'un rôle personnalisé.
  code      String
  name      Json
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  userRoles   UserSiteRole[]

  @@unique([tenantId, code])
  @@map("role")
}

enum GrantLevel {
  full
  approval
  threshold
  read
}

model RolePermission {
  roleId     String     @map("role_id") @db.Uuid
  permission String
  level      GrantLevel

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permission")
}

model UserSiteRole {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  /// Null : le rôle s'applique à tous les sites du client (propriétaire).
  siteId String? @map("site_id") @db.Uuid
  roleId String  @map("role_id") @db.Uuid

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id])
  role Role  @relation(fields: [roleId], references: [id])

  @@unique([userId, siteId])
  @@map("user_site_role")
}

enum AuthMethod {
  password
  pin
}

model AuthSession {
  id               String     @id @default(uuid(7)) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  siteId           String     @map("site_id") @db.Uuid
  deviceId         String?    @map("device_id") @db.Uuid
  method           AuthMethod
  /// Toutes les rotations d'une même connexion partagent la même famille (détection de réutilisation).
  familyId         String     @map("family_id") @db.Uuid
  refreshTokenHash String     @unique @map("refresh_token_hash")
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime?  @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  ip               String?
  userAgent        String?    @map("user_agent")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("auth_session")
}

// ---------------------------------------------------------------- Salle

model Zone {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int       @default(1)

  site   Site          @relation(fields: [siteId], references: [id])
  tables DiningTable[]

  @@map("zone")
}

model DiningTable {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  zoneId     String    @map("zone_id") @db.Uuid
  label      String
  seats      Int       @default(4)
  posX       Int       @default(0) @map("pos_x")
  posY       Int       @default(0) @map("pos_y")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int       @default(1)

  site    Site     @relation(fields: [siteId], references: [id])
  zone    Zone     @relation(fields: [zoneId], references: [id])
  qrCodes QrCode[]
  orders  Order[]

  @@index([siteId])
  @@map("dining_table")
}

enum QrMode {
  menu
  order
}

model QrCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  tableId    String    @map("table_id") @db.Uuid
  /// 128 bits aléatoires (base64url) : ne révèle ni la table ni le site.
  token      String    @unique
  mode       QrMode    @default(order)
  active     Boolean   @default(true)
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  site     Site             @relation(fields: [siteId], references: [id])
  table    DiningTable      @relation(fields: [tableId], references: [id])
  requests QrOrderRequest[]

  @@map("qr_code")
}

enum QrRequestStatus {
  pending
  accepted
  rejected
  expired
}

/// Commande envoyée par un client depuis le menu QR, en attente de validation par le personnel.
model QrOrderRequest {
  id                String          @id @default(uuid(7)) @db.Uuid
  siteId            String          @map("site_id") @db.Uuid
  qrCodeId          String          @map("qr_code_id") @db.Uuid
  tableId           String          @map("table_id") @db.Uuid
  /// SHA-256 du cookie anonyme du client : il ne voit que ses propres demandes.
  clientSessionHash String          @map("client_session_hash")
  idempotencyKey    String          @map("idempotency_key")
  /// Lignes demandées : [{ productId, quantity, modifierIds, note, name, unitPriceXaf, modifiers }].
  items             Json
  totalXaf          Int             @map("total_xaf")
  status            QrRequestStatus @default(pending)
  orderId           String?         @map("order_id") @db.Uuid
  handledById       String?         @map("handled_by") @db.Uuid
  handledAt         DateTime?       @map("handled_at") @db.Timestamptz(3)
  rejectReason      String?         @map("reject_reason")
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  qrCode QrCode      @relation(fields: [qrCodeId], references: [id])
  lines  OrderLine[]

  @@unique([siteId, idempotencyKey])
  @@index([siteId, status])
  @@index([tableId, status])
  @@index([clientSessionHash])
  @@map("qr_order_request")
}

// ---------------------------------------------------------------- Catalogue

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  name        Json
  sortOrder   Int       @default(0) @map("sort_order")
  visibleOnQr Boolean   @default(true) @map("visible_on_qr")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(1)

  site     Site      @relation(fields: [siteId], references: [id])
  products Product[]

  @@map("category")
}

enum Station {
  kitchen
  grill
  bar
}

model Product {
  id          String    @id @default(uuid(7)) @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        Json
  description Json?
  imageUrl    String?   @map("image_url")
  /// Prix TTC en FCFA.
  priceXaf    Int       @map("price_xaf")
  /// Taux de taxe en points de base (1925 = 19,25 %), à valider avec le comptable.
  taxRateBp   Int       @default(0) @map("tax_rate_bp")
  station     Station
  available   Boolean   @default(true)
  visibleOnQr Boolean   @default(true) @map("visible_on_qr")
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(1)

  site           Site                   @relation(fields: [siteId], references: [id])
  category       Category               @relation(fields: [categoryId], references: [id])
  modifierGroups ProductModifierGroup[]
  orderLines     OrderLine[]
  recipeLines    RecipeLine[]

  @@index([siteId, categoryId])
  @@map("product")
}

/// Groupe d'options réutilisable (ex. « Accompagnement », « Cuisson »), rattaché à plusieurs produits.
model ModifierGroup {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  name       Json
  /// Nombre de choix minimum (0 = facultatif) et maximum.
  minSelect  Int       @default(0) @map("min_select")
  maxSelect  Int       @default(1) @map("max_select")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int       @default(1)

  site      Site                   @relation(fields: [siteId], references: [id])
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([siteId])
  @@map("modifier_group")
}

model Modifier {
  id            String    @id @default(uuid(7)) @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  name          Json
  /// Supplément de prix en FCFA (0 si inclus).
  priceDeltaXaf Int       @default(0) @map("price_delta_xaf")
  available     Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeLines RecipeLine[]

  @@index([groupId])
  @@map("modifier")
}

model ProductModifierGroup {
  productId String @map("product_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@map("product_modifier_group")
}

// ---------------------------------------------------------------- Commandes

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum OrderSource {
  staff
  qr
}

enum OrderStatus {
  open
  billed
  paid
  cancelled
}

/// Une commande regroupe tout ce qui est servi à une table jusqu'au paiement.
model Order {
  id          String      @id @default(uuid(7)) @db.Uuid
  siteId      String      @map("site_id") @db.Uuid
  /// Numéro du jour, attribué par le serveur local (repart à 1 chaque jour).
  number      Int
  businessDay DateTime    @map("business_day") @db.Date
  tableId     String?     @map("table_id") @db.Uuid
  type        OrderType   @default(dine_in)
  source      OrderSource @default(staff)
  status      OrderStatus @default(open)
  waiterId    String?     @map("waiter_id") @db.Uuid
  guests      Int?
  openedAt    DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt    DateTime?   @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int         @default(1)

  site    Site            @relation(fields: [siteId], references: [id])
  table   DiningTable?    @relation(fields: [tableId], references: [id])
  lines   OrderLine[]
  tickets KitchenTicket[]
  bills   Bill[]

  @@unique([siteId, businessDay, number])
  @@index([siteId, status])
  @@map("order")
}

enum LineStatus {
  sent
  preparing
  ready
  served
  cancelled
}

model OrderLine {
  id            String      @id @default(uuid(7)) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  /// Instantané au moment de la vente : une modification du catalogue ne change pas l'historique.
  name          Json
  /// Prix unitaire TTC, options comprises (FCFA).
  unitPriceXaf  Int         @map("unit_price_xaf")
  taxRateBp     Int         @map("tax_rate_bp")
  quantity      Int
  /// Options choisies : [{ groupId, modifierId, name, priceDeltaXaf }].
  modifiers     Json        @default("[]")
  note          String?
  station       Station
  status        LineStatus  @default(sent)
  ticketId      String?     @map("ticket_id") @db.Uuid
  createdById   String      @map("created_by") @db.Uuid
  sentAt        DateTime    @default(now()) @map("sent_at") @db.Timestamptz(3)
  servedAt      DateTime?   @map("served_at") @db.Timestamptz(3)
  cancelledAt   DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?     @map("cancelled_by") @db.Uuid
  approvedById  String?     @map("approved_by") @db.Uuid
  cancelReason  String?     @map("cancel_reason")
  /// Statut au moment de l'annulation : sert à la règle de stock (Phase 5).
  cancelledFrom LineStatus? @map("cancelled_from")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Demande QR à l'origine de la ligne (suivi affiché au client).
  qrRequestId String? @map("qr_request_id") @db.Uuid

  order          Order           @relation(fields: [orderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  ticket         KitchenTicket?  @relation(fields: [ticketId], references: [id])
  qrRequest      QrOrderRequest? @relation(fields: [qrRequestId], references: [id])
  billLines      BillLine[]
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([ticketId])
  @@map("order_line")
}

enum TicketStatus {
  new
  preparing
  ready
  served
}

/// Bon de préparation : un par poste et par envoi.
model KitchenTicket {
  id          String       @id @default(uuid(7)) @db.Uuid
  siteId      String       @map("site_id") @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  station     Station
  number      Int
  businessDay DateTime     @map("business_day") @db.Date
  status      TicketStatus @default(new)
  createdById String       @map("created_by") @db.Uuid
  startedAt   DateTime?    @map("started_at") @db.Timestamptz(3)
  readyAt     DateTime?    @map("ready_at") @db.Timestamptz(3)
  servedAt    DateTime?    @map("served_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  site  Site        @relation(fields: [siteId], references: [id])
  order Order       @relation(fields: [orderId], references: [id])
  lines OrderLine[]

  @@unique([siteId, businessDay, number])
  @@index([siteId, status])
  @@map("kitchen_ticket")
}

/// Compteurs séquentiels du site (numéros de commande, de bon…), sans trou ni doublon.
model SiteCounter {
  siteId String @map("site_id") @db.Uuid
  key    String
  value  Int    @default(0)

  @@id([siteId, key])
  @@map("site_counter")
}

/// Réponse mémorisée d'une requête d'écriture : un renvoi (Wi-Fi coupé) ne crée pas de doublon.
model IdempotencyKey {
  siteId    String   @map("site_id") @db.Uuid
  key       String
  userId    String   @map("user_id") @db.Uuid
  route     String
  response  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([siteId, key])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------- Caisse

model CashRegister {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  site     Site          @relation(fields: [siteId], references: [id])
  sessions CashSession[]

  @@map("cash_register")
}

enum CashSessionStatus {
  open
  closed
}

/// Session de caisse : du fond initial à la clôture (théorique, compté, écart justifié).
model CashSession {
  id              String            @id @default(uuid(7)) @db.Uuid
  siteId          String            @map("site_id") @db.Uuid
  registerId      String            @map("register_id") @db.Uuid
  cashierId       String            @map("cashier_id") @db.Uuid
  status          CashSessionStatus @default(open)
  openingFloatXaf Int               @map("opening_float_xaf")
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById      String?           @map("closed_by") @db.Uuid
  /// Totaux théoriques par moyen de paiement au moment de la clôture.
  expected        Json?
  countedCashXaf  Int?              @map("counted_cash_xaf")
  differenceXaf   Int?              @map("difference_xaf")
  comment         String?

  register CashRegister @relation(fields: [registerId], references: [id])
  payments Payment[]

  @@index([siteId, status])
  @@map("cash_session")
}

enum BillStatus {
  open
  paid
  voided
}

/// Addition : tout ou partie des lignes d'une commande (addition séparée possible).
model Bill {
  id                   String     @id @default(uuid(7)) @db.Uuid
  siteId               String     @map("site_id") @db.Uuid
  orderId              String     @map("order_id") @db.Uuid
  status               BillStatus @default(open)
  subtotalXaf          Int        @map("subtotal_xaf")
  discountXaf          Int        @default(0) @map("discount_xaf")
  discountReason       String?    @map("discount_reason")
  discountApprovedById String?    @map("discount_approved_by") @db.Uuid
  totalXaf             Int        @map("total_xaf")
  createdById          String     @map("created_by") @db.Uuid
  paidAt               DateTime?  @map("paid_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int        @default(1)

  order    Order      @relation(fields: [orderId], references: [id])
  lines    BillLine[]
  payments Payment[]
  receipt  Receipt?

  @@index([siteId, status])
  @@index([orderId])
  @@map("bill")
}

model BillLine {
  id          String @id @default(uuid(7)) @db.Uuid
  billId      String @map("bill_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  quantity    Int
  amountXaf   Int    @map("amount_xaf")

  bill      Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id])

  @@index([orderLineId])
  @@map("bill_line")
}

enum PaymentMethod {
  cash
  mtn_momo
  orange_money
  card
  customer_credit
}

enum PaymentStatus {
  recorded
  verified
  voided
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  billId         String        @map("bill_id") @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  method         PaymentMethod
  /// Montant imputé sur l'addition (monnaie rendue déjà déduite).
  amountXaf      Int           @map("amount_xaf")
  /// Espèces remises par le client ; la monnaie rendue est la différence.
  tenderedXaf    Int?          @map("tendered_xaf")
  changeXaf      Int           @default(0) @map("change_xaf")
  /// Référence de transaction (MoMo, Orange Money, carte).
  reference      String?
  customerId     String?       @map("customer_id") @db.Uuid
  status         PaymentStatus @default(recorded)
  idempotencyKey String        @map("idempotency_key")
  createdById    String        @map("created_by") @db.Uuid
  approvedById   String?       @map("approved_by") @db.Uuid
  verifiedById   String?       @map("verified_by") @db.Uuid
  verifiedAt     DateTime?     @map("verified_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by") @db.Uuid
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason     String?       @map("void_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  bill     Bill        @relation(fields: [billId], references: [id])
  session  CashSession @relation(fields: [sessionId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])

  @@unique([siteId, idempotencyKey])
  @@index([billId])
  @@index([sessionId])
  @@map("payment")
}

/// Reçu : numéro séquentiel par site, contenu figé au moment du paiement.
model Receipt {
  id        String   @id @default(uuid(7)) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  number    Int
  billId    String   @unique @map("bill_id") @db.Uuid
  snapshot  Json
  reprints  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bill Bill @relation(fields: [billId], references: [id])

  @@unique([siteId, number])
  @@map("receipt")
}

// ---------------------------------------------------------------- Ardoise client

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  name           String
  phone          String?
  creditLimitXaf Int      @map("credit_limit_xaf")
  note           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int      @default(1)

  site     Site                  @relation(fields: [siteId], references: [id])
  ledger   CustomerLedgerEntry[]
  payments Payment[]

  @@index([siteId])
  @@map("customer")
}

enum LedgerEntryType {
  charge
  payment
  adjustment
}

/// Écriture de l'ardoise : le solde est toujours la somme des écritures, jamais un champ modifiable.
model CustomerLedgerEntry {
  id             String          @id @default(uuid(7)) @db.Uuid
  customerId     String          @map("customer_id") @db.Uuid
  type           LedgerEntryType
  /// Positif : le client doit davantage (charge) ; négatif : il rembourse (payment).
  amountXaf      Int             @map("amount_xaf")
  billId         String?         @map("bill_id") @db.Uuid
  paymentId      String?         @map("payment_id") @db.Uuid
  sessionId      String?         @map("session_id") @db.Uuid
  method         PaymentMethod?
  reference      String?
  createdById    String          @map("created_by") @db.Uuid
  approvedById   String?         @map("approved_by") @db.Uuid
  note           String?
  /// Clé d'idempotence d'un règlement : un renvoi ne crée pas une seconde écriture.
  idempotencyKey String?         @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@map("customer_ledger_entry")
}

// ---------------------------------------------------------------- Cloud (relais du menu QR)
// Ces tables ne servent que dans la base du cloud (API_MODE=cloud).

/// Serveur local autorisé à se connecter au cloud. Le secret n'est conservé que sous forme d'empreinte.
model SiteLink {
  siteId     String    @id @map("site_id") @db.Uuid
  name       String
  secretHash String    @map("secret_hash")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("site_link")
}

/// Menu public d'un site, tel que le serveur local l'a envoyé (champs publics uniquement).
model CloudMenuSnapshot {
  siteId    String   @id @map("site_id") @db.Uuid
  payload   Json
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cloud_menu_snapshot")
}

/// Aiguillage d'un QR code vers son site : seule l'empreinte du jeton est connue du cloud.
model CloudQrRoute {
  tokenHash  String @id @map("token_hash")
  siteId     String @map("site_id") @db.Uuid
  tableLabel String @map("table_label")
  mode       QrMode

  @@index([siteId])
  @@map("cloud_qr_route")
}

/// Photo du menu servie par le cloud : nom du fichier → site qui la détient.
model CloudMediaRoute {
  name   String @id
  siteId String @map("site_id") @db.Uuid

  @@index([siteId])
  @@map("cloud_media_route")
}

// ---------------------------------------------------------------- Impression

enum PrinterRole {
  cashier
  kitchen
  grill
  bar
}

model Printer {
  id         String      @id @default(uuid(7)) @db.Uuid
  siteId     String      @map("site_id") @db.Uuid
  name       String
  host       String
  port       Int         @default(9100)
  /// Largeur du papier en millimètres (58 ou 80).
  paperWidth Int         @default(80) @map("paper_width")
  role       PrinterRole
  active     Boolean     @default(true)
  archivedAt DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int         @default(1)

  site Site       @relation(fields: [siteId], references: [id])
  jobs PrintJob[]

  @@index([siteId])
  @@map("printer")
}

enum PrintJobStatus {
  pending
  printed
  failed
}

model PrintJob {
  id            String         @id @default(uuid(7)) @db.Uuid
  siteId        String         @map("site_id") @db.Uuid
  printerId     String         @map("printer_id") @db.Uuid
  kind          String
  /// Données du document (bon, reçu) : le rendu ESC/POS est fait au moment de l'impression.
  payload       Json
  status        PrintJobStatus @default(pending)
  attempts      Int            @default(0)
  lastError     String?        @map("last_error")
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  printedAt     DateTime?      @map("printed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  printer Printer @relation(fields: [printerId], references: [id])

  @@index([status, nextAttemptAt])
  @@map("print_job")
}

// ---------------------------------------------------------------- Stocks et recettes

/// Unité de base d'un article : toutes les quantités de stock sont exprimées dans cette unité.
enum StockUnit {
  piece
  bottle
  g
  kg
  ml
  l
}

/// Magasin : réserve, bar, cuisine, grill…
model StockLocation {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int       @default(1)

  site            Site             @relation(fields: [siteId], references: [id])
  items           StockItem[]
  levels          StockLevel[]
  movements       StockMovement[]
  goodsReceipts   GoodsReceipt[]
  inventoryCounts InventoryCount[]

  @@index([siteId])
  @@map("stock_location")
}

/// Ce qui se stocke : Castel 65 cl, poulet, charbon…
model StockItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  name           String
  unit           StockUnit
  /// Magasin d'où sortent les ventes et les consommations de l'article.
  locationId     String    @map("location_id") @db.Uuid
  /// Seuil d'alerte, tous magasins confondus (unité de base).
  alertThreshold Decimal   @default(0) @map("alert_threshold") @db.Decimal(14, 3)
  /// Coût moyen pondéré d'une unité de base (FCFA), recalculé à chaque réception.
  avgCostXaf     Decimal   @default(0) @map("avg_cost_xaf") @db.Decimal(14, 4)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int       @default(1)

  site           Site                 @relation(fields: [siteId], references: [id])
  location       StockLocation        @relation(fields: [locationId], references: [id])
  packagings     StockPackaging[]
  levels         StockLevel[]
  movements      StockMovement[]
  recipeLines    RecipeLine[]
  orderLines     PurchaseOrderLine[]
  receiptLines   GoodsReceiptLine[]
  inventoryLines InventoryCountLine[]

  @@index([siteId])
  @@map("stock_item")
}

/// Conditionnement d'achat : 1 casier Castel = 12 bouteilles, 1 sac de charbon = 25 kg.
model StockPackaging {
  id         String    @id @default(uuid(7)) @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  name       String
  factor     Decimal   @db.Decimal(14, 3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  item StockItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("stock_packaging")
}

/// Projection : quantité par article et par magasin, tenue à jour avec chaque mouvement
/// (et recalculable à partir des mouvements).
model StockLevel {
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item     StockItem     @relation(fields: [itemId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@id([itemId, locationId])
  @@index([locationId])
  @@map("stock_level")
}

enum StockMovementType {
  receipt
  sale
  sale_cancel
  transfer_out
  transfer_in
  loss
  breakage
  internal_use
  inventory_adjustment
}

/// Mouvement de stock, en ajout seul (déclencheur) : une erreur se corrige par un mouvement inverse.
model StockMovement {
  id               String            @id @default(uuid(7)) @db.Uuid
  siteId           String            @map("site_id") @db.Uuid
  itemId           String            @map("item_id") @db.Uuid
  locationId       String            @map("location_id") @db.Uuid
  type             StockMovementType
  /// Quantité signée, en unité de base (sortie négative).
  quantity         Decimal           @db.Decimal(14, 3)
  /// Coût moyen de l'article au moment du mouvement (valorisation des pertes et des ventes).
  unitCostXaf      Decimal           @map("unit_cost_xaf") @db.Decimal(14, 4)
  reason           String?
  orderLineId      String?           @map("order_line_id") @db.Uuid
  goodsReceiptId   String?           @map("goods_receipt_id") @db.Uuid
  inventoryCountId String?           @map("inventory_count_id") @db.Uuid
  /// Regroupe les mouvements d'une même opération (les deux côtés d'un transfert).
  groupId          String?           @map("group_id") @db.Uuid
  createdById      String            @map("created_by") @db.Uuid
  approvedById     String?           @map("approved_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  site      Site          @relation(fields: [siteId], references: [id])
  item      StockItem     @relation(fields: [itemId], references: [id])
  location  StockLocation @relation(fields: [locationId], references: [id])
  orderLine OrderLine?    @relation(fields: [orderLineId], references: [id])

  @@index([siteId, createdAt])
  @@index([itemId, createdAt])
  @@index([orderLineId])
  @@map("stock_movement")
}

/// Recette d'un produit vendu : chaque ligne déduit un article. Option liée : la ligne ne compte
/// que si le client a choisi cette option (ex. supplément frites).
model RecipeLine {
  id         String  @id @default(uuid(7)) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  modifierId String? @map("modifier_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)

  product  Product   @relation(fields: [productId], references: [id])
  item     StockItem @relation(fields: [itemId], references: [id])
  modifier Modifier? @relation(fields: [modifierId], references: [id])

  @@index([productId])
  @@index([itemId])
  @@map("recipe_line")
}

// ---------------------------------------------------------------- Achats

model Supplier {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  name       String
  phone      String?
  contact    String?
  note       String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int       @default(1)

  site           Site            @relation(fields: [siteId], references: [id])
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@index([siteId])
  @@map("supplier")
}

enum PurchaseOrderStatus {
  open
  received
  cancelled
}

model PurchaseOrder {
  id          String              @id @default(uuid(7)) @db.Uuid
  siteId      String              @map("site_id") @db.Uuid
  supplierId  String              @map("supplier_id") @db.Uuid
  number      Int
  status      PurchaseOrderStatus @default(open)
  note        String?
  createdById String              @map("created_by") @db.Uuid
  closedAt    DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int                 @default(1)

  site     Site                @relation(fields: [siteId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([siteId, number])
  @@index([siteId, status])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid(7)) @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  itemId           String  @map("item_id") @db.Uuid
  /// Conditionnement commandé (instantané) : nom et nombre d'unités de base.
  unitName         String  @map("unit_name")
  factor           Decimal @db.Decimal(14, 3)
  quantity         Decimal @db.Decimal(14, 3)
  /// Prix convenu par conditionnement (FCFA).
  unitPriceXaf     Int     @map("unit_price_xaf")
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  item          StockItem          @relation(fields: [itemId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_line")
}

/// Réception d'une livraison : figée une fois enregistrée (déclencheur), elle génère les entrées en stock.
model GoodsReceipt {
  id              String   @id @default(uuid(7)) @db.Uuid
  siteId          String   @map("site_id") @db.Uuid
  number          Int
  supplierId      String?  @map("supplier_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  /// N° du bon de livraison ou de la facture du fournisseur.
  reference       String?
  note            String?
  totalXaf        Int      @map("total_xaf")
  idempotencyKey  String   @map("idempotency_key")
  createdById     String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site          Site               @relation(fields: [siteId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  location      StockLocation      @relation(fields: [locationId], references: [id])
  lines         GoodsReceiptLine[]

  @@unique([siteId, number])
  @@unique([siteId, idempotencyKey])
  @@index([siteId, createdAt])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid(7)) @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  itemId              String  @map("item_id") @db.Uuid
  purchaseOrderLineId String? @map("purchase_order_line_id") @db.Uuid
  unitName            String  @map("unit_name")
  factor              Decimal @db.Decimal(14, 3)
  /// Quantité reçue en conditionnements, et convertie en unité de base.
  quantity            Decimal @db.Decimal(14, 3)
  baseQuantity        Decimal @map("base_quantity") @db.Decimal(14, 3)
  unitPriceXaf        Int     @map("unit_price_xaf")
  totalXaf            Int     @map("total_xaf")

  receipt           GoodsReceipt       @relation(fields: [receiptId], references: [id])
  item              StockItem          @relation(fields: [itemId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_line")
}

// ---------------------------------------------------------------- Inventaires

enum InventoryStatus {
  open
  closed
  cancelled
}

/// Inventaire d'un magasin : les écarts constatés à la clôture deviennent des mouvements d'ajustement.
model InventoryCount {
  id           String          @id @default(uuid(7)) @db.Uuid
  siteId       String          @map("site_id") @db.Uuid
  number       Int
  locationId   String          @map("location_id") @db.Uuid
  status       InventoryStatus @default(open)
  note         String?
  /// Valeur nette des écarts (FCFA, au coût moyen), connue à la clôture.
  varianceXaf  Int?            @map("variance_xaf")
  createdById  String          @map("created_by") @db.Uuid
  closedById   String?         @map("closed_by") @db.Uuid
  approvedById String?         @map("approved_by") @db.Uuid
  closedAt     DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int             @default(1)

  site     Site                 @relation(fields: [siteId], references: [id])
  location StockLocation        @relation(fields: [locationId], references: [id])
  lines    InventoryCountLine[]

  @@unique([siteId, number])
  @@index([siteId, status])
  @@map("inventory_count")
}

model InventoryCountLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  countId     String   @map("count_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  /// Quantité comptée ; vide tant que l'article n'a pas été compté.
  countedQty  Decimal? @map("counted_qty") @db.Decimal(14, 3)
  /// Théorique et écart, figés à la clôture.
  expectedQty Decimal? @map("expected_qty") @db.Decimal(14, 3)
  varianceQty Decimal? @map("variance_qty") @db.Decimal(14, 3)
  countedById String?  @map("counted_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  count InventoryCount @relation(fields: [countId], references: [id])
  item  StockItem      @relation(fields: [itemId], references: [id])

  @@unique([countId, itemId])
  @@map("inventory_count_line")
}

// ---------------------------------------------------------------- Dépenses

/// Nature d'une catégorie : charge de fonctionnement, ou achat de marchandises (déjà compté dans le coût
/// des ventes via les stocks, donc exclu du bénéfice estimé pour ne pas le compter deux fois).
enum ExpenseKind {
  operating
  purchase
}

model ExpenseCategory {
  id         String      @id @default(uuid(7)) @db.Uuid
  siteId     String      @map("site_id") @db.Uuid
  name       String
  kind       ExpenseKind @default(operating)
  sortOrder  Int         @default(0) @map("sort_order")
  archivedAt DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int         @default(1)

  site     Site      @relation(fields: [siteId], references: [id])
  expenses Expense[]

  @@index([siteId])
  @@map("expense_category")
}

enum ExpenseMethod {
  cash
  mtn_momo
  orange_money
  card
  bank_transfer
}

enum ExpenseStatus {
  recorded
  voided
}

/// Dépense : jamais supprimée, seulement annulée avec motif. Payée depuis la caisse, elle sort du
/// théorique espèces de la session.
model Expense {
  id               String        @id @default(uuid(7)) @db.Uuid
  siteId           String        @map("site_id") @db.Uuid
  number           Int
  categoryId       String        @map("category_id") @db.Uuid
  /// Jour d'exploitation auquel la dépense se rattache.
  businessDay      DateTime      @map("business_day") @db.Date
  amountXaf        Int           @map("amount_xaf")
  method           ExpenseMethod
  /// Session de caisse d'où sont sortis les espèces (dépense payée depuis la caisse).
  sessionId        String?       @map("session_id") @db.Uuid
  supplierId       String?       @map("supplier_id") @db.Uuid
  description      String
  reference        String?
  /// Justificatif (photo réencodée), stocké hors du dossier public des photos.
  attachment       String?
  status           ExpenseStatus @default(recorded)
  idempotencyKey   String        @map("idempotency_key")
  createdById      String        @map("created_by") @db.Uuid
  approvedById     String?       @map("approved_by") @db.Uuid
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById       String?       @map("voided_by") @db.Uuid
  voidApprovedById String?       @map("void_approved_by") @db.Uuid
  voidReason       String?       @map("void_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int           @default(1)

  site     Site            @relation(fields: [siteId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([siteId, number])
  @@unique([siteId, idempotencyKey])
  @@index([siteId, businessDay])
  @@index([sessionId])
  @@map("expense")
}

// ---------------------------------------------------------------- Remboursements et avoirs

/// Moyen de remboursement ; « customer_credit » = avoir porté au crédit de l'ardoise d'un client.
enum RefundMethod {
  cash
  mtn_momo
  orange_money
  card
  customer_credit
}

/// Remboursement d'une addition payée : en ajout seul (déclencheur), numéroté, avoir imprimé et figé.
model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  number         Int
  billId         String       @map("bill_id") @db.Uuid
  /// Session de caisse de la personne qui rembourse : obligatoire en espèces (elles en sortent).
  sessionId      String?      @map("session_id") @db.Uuid
  method         RefundMethod
  amountXaf      Int          @map("amount_xaf")
  reason         String
  reference      String?
  customerId     String?      @map("customer_id") @db.Uuid
  /// Marchandise intacte remise en stock (lignes remboursées seulement).
  restocked      Boolean      @default(false)
  /// Avoir tel qu'imprimé.
  snapshot       Json
  idempotencyKey String       @map("idempotency_key")
  createdById    String       @map("created_by") @db.Uuid
  approvedById   String?      @map("approved_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  site  Site         @relation(fields: [siteId], references: [id])
  lines RefundLine[]

  @@unique([siteId, number])
  @@unique([siteId, idempotencyKey])
  @@index([billId])
  @@index([sessionId])
  @@map("refund")
}

model RefundLine {
  id          String @id @default(uuid(7)) @db.Uuid
  refundId    String @map("refund_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  quantity    Int
  amountXaf   Int    @map("amount_xaf")

  refund Refund @relation(fields: [refundId], references: [id])

  @@index([refundId])
  @@index([orderLineId])
  @@map("refund_line")
}

// ---------------------------------------------------------------- Audit

/// Journal en ajout seul : un déclencheur PostgreSQL interdit toute modification ou suppression.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  siteId     String?  @map("site_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  approverId String?  @map("approver_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  action     String
  entity     String?
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([siteId, createdAt])
  @@map("audit_log")
}
