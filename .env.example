# Copier ce fichier en .env à la racine du dépôt.

# Base de données (docker compose : pnpm db:up)
DATABASE_URL=postgresql://tchop:tchop@localhost:5434/tchop_dev
TEST_DATABASE_URL=postgresql://tchop:tchop@localhost:5434/tchop_test

# API
API_MODE=site
API_PORT=3000
# Site servi par ce serveur local (créé par le seed de démo)
SITE_ID=0199f000-0000-7000-8000-000000000001
# Secret de signature des jetons : 32 caractères minimum, différent en production
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
WEB_ORIGIN=http://localhost:5180
COOKIE_SECURE=false

# Photos des produits (relatif au dossier de lancement de l API)
MEDIA_DIR=data/media
# Adresse publique du menu client encodée dans les QR codes
PUBLIC_MENU_URL=https://menu.tchoplife.app

# Journée d exploitation : heure de bascule (une vente à 2 h compte pour la veille)
BUSINESS_DAY_CUTOFF_HOUR=6
# File d impression : intervalle de traitement et délai avant nouvelle tentative (ms)
PRINT_POLL_MS=2000
PRINT_RETRY_BASE_MS=2000
